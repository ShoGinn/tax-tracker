{
  "languages": {
    "Python": {
      "language_servers": [
        "ty",
        "ruff"
      ],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      }
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "pnpm",
          "arguments": [
            "--dir",
            "frontend",
            "exec",
            "oxfmt",
            "--stdin-filepath",
            "{buffer_path}"
          ]
        }
      }
    },
    "JSX": {
